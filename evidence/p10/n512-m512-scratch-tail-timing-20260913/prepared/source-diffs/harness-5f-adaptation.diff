+struct DeclaredForce(ForceLimits);
+
+fn no_allocations<T>(f: impl FnOnce() -> T) -> T {
+    let region = Region::new(GLOBAL);
+    let value = f();
+    let change = region.change();
+    assert_eq!(
+        (
+            change.allocations,
+            change.deallocations,
+            change.reallocations
+        ),
+        (0, 0, 0)
+    );
+    value
+}
