+fn sampled_stage_candidate(max_sum_abs: f64, n: usize) -> Result<(f64, u128, f64), String> {
+    if !max_sum_abs.is_finite() || max_sum_abs <= 0.0 || n < 4 {
+        return Err("invalid sampled stage-speed input".into());
+    }
+    let wave = TAU * (n / 2 - 1) as f64;
+    let continuous = 0.3 / (max_sum_abs * wave);
+    let tick_limit = continuous * (1_u128 << 20) as f64;
+    if !tick_limit.is_finite() || tick_limit < 1.0 {
+        return Err("sampled stage candidate has no positive dyadic tick".into());
+    }
+    let ticks = 1_u128 << (tick_limit.floor() as u128).ilog2();
+    let product = ticks as f64 / (1_u128 << 20) as f64 * max_sum_abs * wave;
+    Ok((continuous, ticks, product))
+}
